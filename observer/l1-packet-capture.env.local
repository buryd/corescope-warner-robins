# meshcore-packet-capture config for Wio Tracker L1 → local Warner Robins CoreScope
# Place/copy as: %USERPROFILE%\.meshcore-packet-capture\.env.local
#   or into the cloned repo as .env.local after install.ps1
#
# 1) Flash L1: MeshCore flasher → Wio Tracker L1 → Companion Bluetooth
# 2) Phone app: USA 910.525 / 62.5 / SF7 / CR5, set name, advert with GPS if possible
# 3) Plug L1 into this PC by USB; set SERIAL port below from Device Manager
# 4) CoreScope must be running (MQTT 127.0.0.1:1883)
# 5) Run packet-capture (see README in CoreScope-WarnerRobins)

PACKETCAPTURE_IATA=WRB

# Connection: USB serial (recommended on Windows; BLE is untested)
PACKETCAPTURE_CONNECTION_TYPE=serial
PACKETCAPTURE_SERIAL_PORTS=COM4

# Local CoreScope Mosquitto (docker compose maps 1883)
PACKETCAPTURE_MQTT1_ENABLED=true
PACKETCAPTURE_MQTT1_NAME=corescope-local
PACKETCAPTURE_MQTT1_SERVER=127.0.0.1
PACKETCAPTURE_MQTT1_PORT=1883
PACKETCAPTURE_MQTT1_USE_TLS=false
PACKETCAPTURE_MQTT1_TRANSPORT=tcp
